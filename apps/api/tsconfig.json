{
  "include": ["src"],
  "exclude": ["node_modules", "dist", "build", ".turbo", "coverage", ".sst", ".tsc-output"],
  "references": [{ "path": "../../packages/api-contracts" }],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@db": ["./src/db/index.ts"],
      "@db/*": ["./src/db/*"],
      "@errors": ["./src/errors/index.ts"],
      "@errors/*": ["./src/errors/*"],
      "@services/*": ["./src/services/*"],
      "@utils/*": ["./src/utils/*"]
    }
  }
}
