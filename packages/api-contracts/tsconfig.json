{
  "include": ["src"],
  "exclude": ["node_modules", "dist", "build", ".turbo", "coverage", ".tsc-output"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./.tsc-output",
    "rootDir": "./src"
  }
}
